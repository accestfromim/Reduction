# Copy to local.env and fill in. local.env is ignored by git: it describes one machine and one person.

# The toolchain. Leave out what is already on the PATH or in the environment.
#JAVA_HOME=/path/to/jdk-17
#ANDROID_HOME=/path/to/android-sdk
#GRADLE="/path/to/gradle-8.9/bin/gradle --offline"

# Updates for the phone app (optional). The app asks this address for manifest.json; leave it empty and
# the app never looks for updates. tools/release/publish.sh uploads a new version to the place it is served from.
#REDUCTION_UPDATE_MANIFEST=http://your.server/reduction/manifest.json
#REDUCTION_UPDATE_HOST=your-ssh-host            # as in ~/.ssh/config
#REDUCTION_UPDATE_DIR=/var/www/reduction        # the directory on that host behind the address above
